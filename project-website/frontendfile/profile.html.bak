<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile — Campus Nexus</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar" id="main-nav"></nav>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-section-label">Main Menu</div>
            <ul class="sidebar-nav">
                <li><a href="/dashboard.html"><span class="nav-icon">📊</span>Overview</a></li>
                <li><a href="/projects.html"><span class="nav-icon">🔬</span>Projects</a></li>
                <li><a href="/applications.html"><span class="nav-icon">📋</span>Applications</a></li>
                <li><a href="/events.html"><span class="nav-icon">📅</span>Events</a></li>
                <li><a href="/messages.html"><span class="nav-icon">💬</span>Messages</a></li>
                <li><a href="/management.html"><span class="nav-icon">🏗️</span>Management</a></li>
                <li><a href="/profile.html" class="active"><span class="nav-icon">👤</span>Profile</a></li>
            </ul>
        </aside>

        <main class="dashboard-content">
            <!-- Profile Banner Card -->
            <div class="card animate-in" style="padding:0;overflow:hidden;margin-bottom:1.75rem;">
                <div class="profile-banner">
                    <div class="avatar-ring" id="avatarRing">AS</div>
                </div>
                <div style="padding:3.5rem 2rem 1.75rem;text-align:center;">
                    <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.6rem;font-weight:800;color:var(--text-dark);" id="profileHeaderName">Niyati Goplani</h2>
                    <div style="font-size:0.875rem;color:var(--primary-light);font-weight:600;margin-top:0.2rem;" id="profileHeaderRole">Full-Stack Lead & Senior Computer Science Scholar</div>
                    <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;font-family:'JetBrains Mono',monospace;">
                        🎓 Roll No: <strong>24CS0192</strong> &nbsp;·&nbsp; 🌟 Cumulative GPA: <strong>3.92 / 4.00</strong> &nbsp;·&nbsp; 🏢 Computer Science Dept
                    </div>
                    
                    <p style="max-width:640px;margin:0.85rem auto 1.25rem;font-size:0.9rem;color:var(--text-secondary);line-height:1.6;" id="profileHeaderBio">
                        Full-Stack Developer & Smart Infrastructure Enthusiast. Leading the Smart Campus Energy Micro-Grid project with Dr. Vikram Samant. Passionate about real-time telemetry and clean energy IoT systems.
                    </p>

                    <div style="display:flex;gap:0.65rem;justify-content:center;flex-wrap:wrap;margin-bottom:1rem;">
                        <a href="https://github.com" target="_blank" class="btn btn-outline btn-sm">🔗 GitHub Profile</a>
                        <a href="https://linkedin.com" target="_blank" class="btn btn-outline btn-sm">💼 LinkedIn</a>
                        <a href="mailto:niyati.g@student.edu" class="btn btn-soft btn-sm">✉️ Email Scholar</a>
                    </div>
                </div>
            </div>

            <!-- Profile Tabs -->
            <div class="tabs animate-in animate-delay-1" data-tab-group="prof">
                <button class="tab-btn active" data-tab="overview" onclick="switchTab('prof','overview')">📊 Portfolio & Skillset</button>
                <button class="tab-btn" data-tab="projects" onclick="switchTab('prof','projects')">🔬 Projects Led (4)</button>
                <button class="tab-btn" data-tab="certs" onclick="switchTab('prof','certs')">🏆 Certifications & Awards</button>
                <button class="tab-btn" data-tab="edit" onclick="switchTab('prof','edit')">⚙️ Edit Profile Settings</button>
            </div>

            <!-- Overview Panel -->
            <div data-tab-content="prof" data-tab="overview" class="tab-panel active">
                <div class="grid-cols-2 mb-3">
                    <!-- Technical Skills Bar -->
                    <div class="card">
                        <div class="section-title mb-3">⚡ Technical Skills & Proficiency</div>
                        <div style="display:flex;flex-direction:column;gap:1.1rem;">
                            <div>
                                <div class="flex-between" style="font-size:0.85rem;margin-bottom:0.35rem;">
                                    <span>React / Next.js / TypeScript</span>
                                    <span style="font-weight:700;color:var(--primary-light);">95%</span>
                                </div>
                                <div class="progress-bar-wrap"><div class="progress-bar-fill progress-purple" style="width:95%;"></div></div>
                            </div>
                            <div>
                                <div class="flex-between" style="font-size:0.85rem;margin-bottom:0.35rem;">
                                    <span>Node.js / Express / REST APIs</span>
                                    <span style="font-weight:700;color:var(--accent-teal);">90%</span>
                                </div>
                                <div class="progress-bar-wrap"><div class="progress-bar-fill progress-teal" style="width:90%;"></div></div>
                            </div>
                            <div>
                                <div class="flex-between" style="font-size:0.85rem;margin-bottom:0.35rem;">
                                    <span>Python / PyTorch / Data Analytics</span>
                                    <span style="font-weight:700;color:var(--accent-amber);">85%</span>
                                </div>
                                <div class="progress-bar-wrap"><div class="progress-bar-fill progress-amber" style="width:85%;"></div></div>
                            </div>
                            <div>
                                <div class="flex-between" style="font-size:0.85rem;margin-bottom:0.35rem;">
                                    <span>IoT Sensors, ESP32 & MQTT Protocol</span>
                                    <span style="font-weight:700;color:var(--accent-rose);">80%</span>
                                </div>
                                <div class="progress-bar-wrap"><div class="progress-bar-fill progress-rose" style="width:80%;"></div></div>
                            </div>
                            <div>
                                <div class="flex-between" style="font-size:0.85rem;margin-bottom:0.35rem;">
                                    <span>MySQL / PostgreSQL Database Tuning</span>
                                    <span style="font-weight:700;color:var(--primary-light);">88%</span>
                                </div>
                                <div class="progress-bar-wrap"><div class="progress-bar-fill progress-purple" style="width:88%;"></div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Impact Metrics -->
                    <div class="card">
                        <div class="section-title mb-3">📈 Academic Metrics & Achievements</div>
                        <div class="grid-cols-2 gap-2 mb-3">
                            <div class="card-flat text-center">
                                <div style="font-size:1.8rem;font-weight:800;color:var(--primary-light);font-family:'Plus Jakarta Sans';">16</div>
                                <div style="font-size:0.78rem;color:var(--text-muted);margin-top:0.2rem;">Projects Completed</div>
                            </div>
                            <div class="card-flat text-center">
                                <div style="font-size:1.8rem;font-weight:800;color:var(--accent-teal);font-family:'Plus Jakarta Sans';">3</div>
                                <div style="font-size:0.78rem;color:var(--text-muted);margin-top:0.2rem;">Hackathons Won</div>
                            </div>
                            <div class="card-flat text-center">
                                <div style="font-size:1.8rem;font-weight:800;color:var(--accent-amber);font-family:'Plus Jakarta Sans';">4</div>
                                <div style="font-size:0.78rem;color:var(--text-muted);margin-top:0.2rem;">Faculty Recommendations</div>
                            </div>
                            <div class="card-flat text-center">
                                <div style="font-size:1.8rem;font-weight:800;color:var(--accent-rose);font-family:'Plus Jakarta Sans';">100%</div>
                                <div style="font-size:0.78rem;color:var(--text-muted);margin-top:0.2rem;">On-Time Delivery</div>
                            </div>
                        </div>
                        <div class="info-box">
                            🎓 Faculty Advisor: <strong>Dr. Vikram Samant</strong> (Smart Energy Research Lab)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Projects Panel -->
            <div data-tab-content="prof" data-tab="projects" class="tab-panel">
                <div id="profileProjectsList">
                    <!-- Rendered by JS -->
                </div>
            </div>

            <!-- Certs Panel -->
            <div data-tab-content="prof" data-tab="certs" class="tab-panel">
                <div class="grid-cols-2">
                    <div class="card-flat" style="padding:1.25rem;">
                        <div style="font-size:1.8rem;margin-bottom:0.5rem;">🏆</div>
                        <div style="font-weight:700;font-size:1rem;color:var(--text-dark);">1st Place — Campus Clean Energy Hackathon 2025</div>
                        <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;">Awarded by the Department of Electrical & Clean Energy Engineering for solar grid load shed controller.</div>
                    </div>
                    <div class="card-flat" style="padding:1.25rem;">
                        <div style="font-size:1.8rem;margin-bottom:0.5rem;">📜</div>
                        <div style="font-weight:700;font-size:1rem;color:var(--text-dark);">AWS Certified Solutions Architect (Associate)</div>
                        <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;">Validation ID: AWS-78901234 · Specialized in Serverless Microservices & Cloud Infrastructure.</div>
                    </div>
                    <div class="card-flat" style="padding:1.25rem;">
                        <div style="font-size:1.8rem;margin-bottom:0.5rem;">🎖️</div>
                        <div style="font-weight:700;font-size:1rem;color:var(--text-dark);">IEEE Outstanding Student Researcher Award 2026</div>
                        <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;">Recognized for co-authoring IoT micro-grid telemetry security protocols paper with Dr. Rajesh Kumar.</div>
                    </div>
                    <div class="card-flat" style="padding:1.25rem;">
                        <div style="font-size:1.8rem;margin-bottom:0.5rem;">📜</div>
                        <div style="font-weight:700;font-size:1rem;color:var(--text-dark);">Meta Professional Front-End Developer Certificate</div>
                        <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.35rem;">Mastery of React, Advanced CSS, Accessibility Standards, and Single Page Application Architecture.</div>
                    </div>
                </div>
            </div>

            <!-- Edit Settings Panel (Preserved IDs) -->
            <div data-tab-content="prof" data-tab="edit" class="tab-panel">
                <div class="card" style="max-width:680px;">
                    <div class="section-title mb-3">⚙️ Profile Information Settings</div>
                    <form id="profileForm">
                        <div class="grid-cols-2">
                            <div class="form-group">
                                <label>Full Name *</label>
                                <input type="text" id="pName" class="form-control" required placeholder="Niyati Goplani">
                            </div>
                            <div class="form-group">
                                <label>University Email *</label>
                                <input type="email" id="pEmail" class="form-control" required placeholder="niyati.g@student.edu">
                            </div>
                        </div>
                        <div class="grid-cols-2">
                            <div class="form-group">
                                <label>Role / Title</label>
                                <input type="text" id="pRole" class="form-control" placeholder="Full-Stack Lead & Senior Student">
                            </div>
                            <div class="form-group">
                                <label>Department</label>
                                <input type="text" id="pDept" class="form-control" placeholder="Computer Science & Engineering">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Personal Bio</label>
                            <textarea id="pBio" class="form-control" style="min-height:90px;" placeholder="Tell peers and mentors about your technical background and research interests..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Skills (comma-separated)</label>
                            <input type="text" id="pSkills" class="form-control" placeholder="React, Node.js, Python, MQTT, SQL">
                        </div>
                        <div style="display:flex;gap:1rem;align-items:center;margin-top:1.25rem;">
                            <button type="submit" class="btn btn-primary" id="saveBtn">💾 Save Profile Changes</button>
                            <span id="profileMsg" style="font-size:0.85rem;"></span>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/utils.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', async () => {
        const user = await checkAuth();
        if (!user) return;

        // Fill Form Fields (Preserved IDs)
        document.getElementById('pName').value = user.name || 'Niyati Goplani';
        document.getElementById('pEmail').value = user.email || 'niyati.g@student.edu';
        document.getElementById('pRole').value = user.role || 'Full-Stack Lead & Senior Scholar';
        document.getElementById('pDept').value = user.department || 'Computer Science';
        document.getElementById('pBio').value = user.bio || 'Full-Stack Developer & Smart Infrastructure Enthusiast. Leading the Smart Campus Energy Micro-Grid project with Dr. Vikram Samant.';
        document.getElementById('pSkills').value = user.skills || 'React, Node.js, Python, MQTT, SQL';

        // Render Projects Led
        const projContainer = document.getElementById('profileProjectsList');
        const myProjects = window.CAMPUS_DATA.projects.filter(p => p.owner_id === 1 || p.owner_name === 'Niyati Goplani');
        projContainer.innerHTML = myProjects.map(p => `
            <div class="card-flat mb-2" style="padding:1.25rem;">
                <div class="flex-between">
                    <div style="font-weight:700;font-size:1.05rem;color:var(--text-dark);">${p.title}</div>
                    <span class="badge badge-purple">${p.category}</span>
                </div>
                <p style="font-size:0.85rem;color:var(--text-secondary);margin:0.4rem 0;">${p.description}</p>
                <div style="font-size:0.78rem;color:var(--text-muted);">
                    🎓 Mentor: ${p.mentor} &nbsp;·&nbsp; 👥 Team of ${p.team_size} &nbsp;·&nbsp; 🗓 Deadline: ${p.deadline}
                </div>
            </div>
        `).join('');

        // Submit Profile Form (Preserved API call)
        document.getElementById('profileForm').addEventListener('submit', async e => {
            e.preventDefault();
            const btn = document.getElementById('saveBtn');
            btn.textContent = 'Saving...'; btn.disabled = true;

            const name = document.getElementById('pName').value;
            const email = document.getElementById('pEmail').value;
            const role = document.getElementById('pRole').value;
            const department = document.getElementById('pDept').value;
            const bio = document.getElementById('pBio').value;
            const skills = document.getElementById('pSkills').value;

            try {
                await fetch('/api/profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, role, department, bio, skills })
                });
            } catch(err){}

            document.getElementById('profileHeaderName').textContent = name;
            document.getElementById('profileHeaderBio').textContent = bio;
            showMessage('profileMsg', '✓ Profile settings saved!');

            btn.textContent = '💾 Save Profile Changes'; btn.disabled = false;
        });
    });
    </script>
</body>
</html>
